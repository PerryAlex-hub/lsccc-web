# General enquiries only. Leave unset until the centre confirms its inbox.
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Neon: one pooled URL for both the application and Prisma CLI.
DATABASE_URL=

# Neon Object Storage: copy from Connect > Storage. Keep keys private.
AWS_ENDPOINT_URL_S3=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
STORAGE_BUCKET_NAME=lsccc-media

# Used in invitation and password recovery emails in the authentication batch.
APP_URL=http://localhost:3000
AUTH_FROM_EMAIL=

